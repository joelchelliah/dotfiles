# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Where this dotfiles repo lives. Everything else is derived from it.
export DOTFILES="${DOTFILES:-$HOME/src/dotfiles}"

# # # # # # # # # # # # # # # # # # # # # # # #
# #               OH MY ZSH                 # #
# # # # # # # # # # # # # # # # # # # # # # # #

export ZSH="$HOME/.oh-my-zsh"

# Point oh-my-zsh at the custom dir inside this repo, so ~/.oh-my-zsh stays a
# disposable upstream checkout that `omz update` can manage freely.
# MUST be set before sourcing oh-my-zsh.sh.
export ZSH_CUSTOM="$DOTFILES/zsh/custom"

# Powerlevel10k is installed via Homebrew (see Brewfile) and sourced after
# oh-my-zsh below, so no ZSH_THEME is set here.
ZSH_THEME=""

# Display red dots whilst waiting for completion.
COMPLETION_WAITING_DOTS="true"

# Skip the verification of insecure directories
ZSH_DISABLE_COMPFIX="true"

plugins=(git command-not-found docker-compose)

fpath=($ZSH_CUSTOM/completions $fpath)

source $ZSH/oh-my-zsh.sh

# Homebrew-managed theme + plugins (installed via Brewfile, not vendored here).
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme" 2>/dev/null
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null

# # # # # # # # # # # # # # # # # # # # # # # #
# #                 LOCALE                  # #
# # # # # # # # # # # # # # # # # # # # # # # #

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# # # # # # # # # # # # # # # # # # # # # # # #
# #                  PATH                    # #
# # # # # # # # # # # # # # # # # # # # # # # #

export BIN="$HOME/bin"
path=(
  "$BIN"
  "$HOME/.local/bin"
  "$HOMEBREW_PREFIX/opt/curl/bin"
  "$HOMEBREW_PREFIX/bin"
  $path
)
typeset -U path  # de-duplicate

# # # # # # # # # # # # # # # # # # # # # # # #
# #        LANGUAGE / RUNTIME VERSIONS       # #
# # # # # # # # # # # # # # # # # # # # # # # #

# mise replaces nvm, rbenv, pyenv and the hand-rolled JAVA_HOME export.
# It reads .nvmrc / .python-version / .mise.toml and switches automatically on cd.
#   mise use -g node@22     install + set global default
#   mise use node@20        pin for the current project
#   mise ls                 what's installed
#   mise current            what's active here
eval "$(mise activate zsh)"

### NODE
export NODE_OPTIONS=--max_old_space_size=4096

### YARN
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

### PNPM
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# # # # # # # # # # # # # # # # # # # # # # # #
# #             APPLICATIONS                 # #
# # # # # # # # # # # # # # # # # # # # # # # #

### ANDROID
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools"

### GCLOUD
export GCLOUD_HOME="$BIN/google-cloud-sdk"
[ -f "$GCLOUD_HOME/path.zsh.inc" ] && source "$GCLOUD_HOME/path.zsh.inc"
[ -f "$GCLOUD_HOME/completion.zsh.inc" ] && source "$GCLOUD_HOME/completion.zsh.inc"

### GRADLE
export GRADLE_PROPS="$HOME/.gradle/gradle.properties"

### DOCKER / COLIMA
export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
export TESTCONTAINERS_RYUK_DISABLED=true
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

### FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# # # # # # # # # # # # # # # # # # # # # # # #
# #                COMPLETION                # #
# # # # # # # # # # # # # # # # # # # # # # # #

autoload -Uz compinit && compinit -i

### AUTOSUGGEST CONFIG
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# Accept suggestion with Tab instead of right-arrow
bindkey '^I' autosuggest-accept

# # # # # # # # # # # # # # # # # # # # # # # #
# #               KEY BINDINGS               # #
# # # # # # # # # # # # # # # # # # # # # # # #

# Shift+Left / Shift+Right — word jump
bindkey "^[[1;2D" backward-word
bindkey "^[[1;2C" forward-word

# Shift+Cmd+Left / Shift+Cmd+Right — kill word backward/forward
bindkey "^[[1;10D" backward-kill-word
bindkey "^[[1;10C" kill-word

# # # # # # # # # # # # # # # # # # # # # # # #
# #                  PROMPT                  # #
# # # # # # # # # # # # # # # # # # # # # # # #

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# # # # # # # # # # # # # # # # # # # # # # # #
# #            MACHINE-LOCAL / SECRETS       # #
# # # # # # # # # # # # # # # # # # # # # # # #

# Tokens, work-specific config, anything that must not be committed.
# Kept last so it can override anything above.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
