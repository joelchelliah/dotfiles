cursor-style = bar
cursor-style-blink = true
# stops vi-mode from hijacking cursor shape
shell-integration-features = no-cursor

mouse-hide-while-typing = true

# Moving the cursor at prompts by clicking on a location in the prompt text
cursor-click-to-move = true

# Copy selected text
copy-on-select = true

notify-on-command-finish = unfocused

background-blur = macos-glass-clear


# ghostty-theme-mixer
theme = Solarized Dark Patched
foreground = 9999aa
background = 1f1f2a
font-family = "Fira Code"
font-size = 14
minimum-contrast = 3

# Punchier green than Solarized's olive #859900
palette = 2=#5faf5f
palette = 10=#87d787
